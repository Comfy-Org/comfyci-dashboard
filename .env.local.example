# your url here
NEXT_PUBLIC_BACKEND_URL=https://api.comfy.org
# development or production
NEXT_PUBLIC_ENV=development
# insert mixpanel key here if you have one
NEXT_PUBLIC_MIXPANEL_KEY=
# base URL of the GCS prefix holding GPU regression results (public bucket)
NEXT_PUBLIC_GCS_REGRESSION_BASE=https://storage.googleapis.com/comfy-ci-results/regression
