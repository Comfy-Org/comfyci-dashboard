# your url here
NEXT_PUBLIC_BACKEND_URL=https://api.comfy.org
# development or production
NEXT_PUBLIC_ENV=development
# insert mixpanel key here if you have one
NEXT_PUBLIC_MIXPANEL_KEY=
# base URL of the public prefix holding GPU regression results; defaults to the
# worker repo's results branch. Point at GCS once results move there, e.g.
# https://storage.googleapis.com/comfy-ci-results/regression
NEXT_PUBLIC_REGRESSION_BASE=https://raw.githubusercontent.com/Comfy-Org/comfyci-runpod-worker/results/regression
